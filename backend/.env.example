DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/graduatelink
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
APP_ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
UPLOAD_DIRECTORY=uploads
MAX_VERIFICATION_DOCUMENT_BYTES=5000000
MAX_RESUME_BYTES=5000000

# Optional email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SUPPORT_EMAIL=

# Optional local GradBot settings
OLLAMA_HOST=http://127.0.0.1:11434
GRADBOT_CHAT_MODEL=qwen3:4b
GRADBOT_EMBED_MODEL=embeddinggemma
GRADBOT_ADAPTER_PATH=app/models/gradbot_qwen3_adapter
